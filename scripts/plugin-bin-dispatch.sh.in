#!/bin/sh
# Generated by scripts/bundle-plugin.sh — do not edit.
#
# Runs the binary built for this machine. `__NAME__` is substituted when a
# bundle is assembled; scripts/check-bundle-dispatch.sh drives every branch
# below against stand-ins, so a wrong turn here fails CI rather than someone's
# session.
#
# Windows does reach this file. A hook with no `args` runs through a shell, and
# where Git Bash is installed that shell is bash, which executes this script
# rather than the sibling .exe a direct spawn would have resolved. So hand off
# to the .exe by name: under MSYS a bare "$dir/__NAME__" resolves back here.
set -e

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

case $(uname -s) in
    Darwin) os=apple-darwin ;;
    Linux) os=unknown-linux-gnu ;;
    MINGW* | MSYS* | CYGWIN*) exec "$dir/__NAME__.exe" "$@" ;;
    *) echo "__NAME__: unsupported operating system $(uname -s)" >&2 ; exit 1 ;;
esac

case $(uname -m) in
    arm64 | aarch64) arch=aarch64 ;;
    x86_64 | amd64) arch=x86_64 ;;
    *) echo "__NAME__: unsupported architecture $(uname -m)" >&2 ; exit 1 ;;
esac

target="$arch-$os"
exe="$dir/$target/__NAME__"

if [ ! -x "$exe" ]; then
    echo "__NAME__: this plugin ships no binary for $target" >&2
    exit 1
fi

exec "$exe" "$@"
