{
  "name": "repo-tasks-mcp-qwen",
  "version": "0.2.0",
  "displayName": "repo-tasks-mcp-qwen — a per-repository task list for Qwen Code",
  "description": "A task list kept per git repository, shared with other agents working in it: four MCP tools to create, list, read and update tasks, and a session-start line saying how many are open.",
  "license": "PolyForm-Noncommercial-1.0.0",
  "contextFileName": "QWEN.md",
  "mcpServers": {
    "repo-tasks-mcp-qwen": {
      "command": "${extensionPath}${/}bin${/}repo-tasks-qwen-mcp",
      "args": [
        "serve"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "${extensionPath}${/}bin${/}repo-tasks-qwen-mcp reminder --event qwen",
            "name": "repo-tasks-qwen-reminder",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "${extensionPath}${/}bin${/}repo-tasks-qwen-mcp reminder --event qwen",
            "name": "repo-tasks-qwen-reminder",
            "timeout": 10000
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "${extensionPath}${/}bin${/}repo-tasks-qwen-mcp reminder --event qwen",
            "name": "repo-tasks-qwen-reminder",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
