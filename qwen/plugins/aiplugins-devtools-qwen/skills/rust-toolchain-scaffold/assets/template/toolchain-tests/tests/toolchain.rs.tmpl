#[test]
fn commit_msg_blocks_a_token_in_the_message() {
    let dir = hooked_repo();
    append(dir.path(), "src/lib.rs", CLEAN_ADDITION);
    let ran = commit(dir.path(), &format!("leak {}", fake_token()));
    assert!(blocked(&ran), "{}", ran.output);
