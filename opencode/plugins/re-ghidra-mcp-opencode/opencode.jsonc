{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "ghidra": {
        "type": "local",
        "command": ["./bin/re-ghidra-cc-mcp", "serve"],
        "environment": { "RE_GHIDRA_HOST": "opencode" },
        "disabled": false,
        "timeout": { "catalog": 30000, "execution": 30000 }
      }
    }
  },
  "permissions": [],
  "skills": []
}
